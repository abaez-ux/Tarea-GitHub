#:import dp kivy.metrics.dp

# <PerfilScreen> es el nombre de la clase de perfil.py: todo lo que está
# acá abajo (con sangría) es el diseño de esa pantalla.
# Dentro de este bloque, "root" siempre significa la pantalla (PerfilScreen).
<PerfilScreen>:
    # theme_bg_color: "Custom" avisa que el fondo va a usar un color propio
    # en lugar del color automático del tema. Sin esta línea, md_bg_color no se aplica.
    theme_bg_color: "Custom"
    # md_bg_color es el color de fondo: rojo, verde, azul, transparencia (cada número va de 0 a 1).
    # Ejemplo: 1, 1, 1, 1 es blanco y 0, 0, 0, 1 es negro.
    md_bg_color: 1, 0.86, 0.77, 1

    # Flecha para volver (arriba a la izquierda)
    MDIconButton:
        icon: "arrow-left"
        pos_hint: {"x": .05, "top": .92}
        theme_icon_color: "Custom"
        icon_color: 0, .592, .698, 1
        # root.volver() ejecuta el método volver() de PerfilScreen (perfil.py).
        on_release: root.volver()

    # Columna centrada con el contenido de la pantalla
    # MDBoxLayout acomoda a sus hijos uno debajo del otro (orientation: "vertical").
    MDBoxLayout:
        orientation: "vertical"
        # adaptive_height: True hace que su alto sea justo el que ocupan sus hijos.
        adaptive_height: True
        # size_hint_x: None desactiva el ancho proporcional para poder fijar un ancho exacto (width).
        size_hint_x: None
        width: "320dp"
        # spacing es el espacio entre un hijo y el siguiente.
        spacing: "14dp"
        # center_x y center_y en .5 centran el bloque horizontal y verticalmente.
        pos_hint: {"center_x": .5, "center_y": .5}

        # MDLabel muestra un texto.
        MDLabel:
            text: "Datos del usuario"
            font_style: "Headline"
            role: "small"
            theme_font_size: "Custom"
            # font_size cambia el tamaño de la letra ("sp" es la unidad de tamaño de texto).
            font_size: "30sp"
            bold: True
            # halign: "left" alinea el texto a la izquierda (también puede ser "center" o "right").
            halign: "left"
            adaptive_height: True
            padding: 0, 0, 0, "16dp"
            theme_text_color: "Custom"
            text_color: 0, .592, .698, 1

        # Datos inventados. En la clase 3 van a ser los del usuario que inició sesión.
        MDLabel:
            text: "NOMBRE: Nombre Apellido"
            # font_style y role eligen el tamaño base de letra: "Body" es el estilo de texto común.
            font_style: "Body"
            role: "medium"
            adaptive_height: True
            padding: 0, "2dp", 0, "2dp"
            theme_text_color: "Custom"
            text_color: 0, 0, 0, 1

        MDLabel:
            text: "EDAD: 00"
            # font_style y role eligen el tamaño base de letra: "Body" es el estilo de texto común.
            font_style: "Body"
            role: "medium"
            adaptive_height: True
            padding: 0, "2dp", 0, "2dp"
            theme_text_color: "Custom"
            text_color: 0, 0, 0, 1

        MDLabel:
            text: "CORREO: usuario@ejemplo.com"
            # font_style y role eligen el tamaño base de letra: "Body" es el estilo de texto común.
            font_style: "Body"
            role: "medium"
            adaptive_height: True
            padding: 0, "2dp", 0, "2dp"
            theme_text_color: "Custom"
            text_color: 0, 0, 0, 1

    MDButton:
        style: "filled"
        size_hint: None, None
        size: "180dp", "48dp"
        pos_hint: {"center_x": .5, "y": .08}
        theme_bg_color: "Custom"
        md_bg_color: 0, .800, .698, 1
        on_release: root.cerrar_sesion()
        MDButtonText:
            text: "Cerrar sesión"
            pos_hint: {"center_x": .5, "center_y": .5}
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            bold: True
