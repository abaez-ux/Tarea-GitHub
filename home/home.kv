#:import dp kivy.metrics.dp

# <HomeScreen> es el nombre de la clase de home.py: todo lo que está
# acá abajo (con sangría) es el diseño de esa pantalla.
# Dentro de este bloque, "root" siempre significa la pantalla (HomeScreen).
<HomeScreen>:
    # theme_bg_color: "Custom" avisa que el fondo va a usar un color propio
    # en lugar del color automático del tema. Sin esta línea, md_bg_color no se aplica.
    theme_bg_color: "Custom"
    # md_bg_color es el color de fondo: rojo, verde, azul, transparencia (cada número va de 0 a 1).
    # Ejemplo: 1, 1, 1, 1 es blanco y 0, 0, 0, 1 es negro.
    md_bg_color: 1, 0.86, 0.77, 1

    # Botón de perfil (arriba a la derecha)
    # MDIconButton es un botón que muestra solo un ícono.
    MDIconButton:
        # icon es el nombre del ícono, tal como aparece en https://pictogrammers.com/library/mdi/
        icon: "account-circle-outline"
        # "right": .94 deja su borde derecho al 94% del ancho y "top": .92 su borde superior al 92% del alto.
        pos_hint: {"right": .94, "top": .92}
        theme_icon_color: "Custom"
        icon_color: 0, .592, .698, 1
        on_release: root.ir_a_perfil()

    # Columna centrada con el contenido de la pantalla
    # MDBoxLayout acomoda a sus hijos uno debajo del otro (orientation: "vertical").
    MDBoxLayout:
        orientation: "vertical"
        # adaptive_height: True hace que su alto sea justo el que ocupan sus hijos.
        adaptive_height: True
        # size_hint_x: None desactiva el ancho proporcional para poder fijar un ancho exacto (width).
        size_hint_x: None
        width: "320dp"
        # spacing es el espacio entre un hijo y el siguiente.
        spacing: "14dp"
        # center_x y center_y en .5 centran el bloque horizontal y verticalmente.
        pos_hint: {"center_x": .5, "center_y": .5}

        # MDLabel muestra un texto.
        MDLabel:
            text: "Home"
            font_style: "Headline"
            role: "small"
            theme_font_size: "Custom"
            # font_size cambia el tamaño de la letra ("sp" es la unidad de tamaño de texto).
            font_size: "30sp"
            bold: True
            halign: "center"
            adaptive_height: True
            padding: 0, 0, 0, "16dp"
            theme_text_color: "Custom"
            text_color: 0, .592, .698, 1

        # MDButton es un botón con texto. El texto va en un MDButtonText adentro.
        MDButton:
            style: "filled"
            theme_width: "Custom"
            theme_height: "Custom"
            # size_hint: 1, None significa ancho = 100% del contenedor y alto fijo (el de height).
            size_hint: 1, None
            height: "48dp"
            radius: [dp(6), dp(6), dp(6), dp(6)]
            theme_bg_color: "Custom"
            md_bg_color: 0, .800, .698, 1
            # on_release es lo que pasa al soltar el botón después de tocarlo.
            # root.opcion_1() ejecuta el método opcion_1() de HomeScreen (home.py).
            # root.manager es el administrador de pantallas de app.py, y root.manager.current
            # es el nombre de la pantalla que se está mostrando: escribir en el .kv
            # root.manager.current = "perfil" cambia de pantalla igual que lo hace ese método.
            on_release: root.opcion_1()

            MDButtonText:
                text: "Opción 1"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True

        MDButton:
            style: "filled"
            size_hint: 1, None
            height: "48dp"
            radius: [dp(6), dp(6), dp(6), dp(6)]
            theme_bg_color: "Custom"
            md_bg_color: 0, .800, .698, 1
            on_release: root.ir_a_perfil()
            MDButtonText:
                text: "Opción 2"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
